// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ActivityStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum CheckInMethod {
  QR
  MANUAL
  GPS
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum HealthSource {
  GOOGLE_HEALTH
  APPLE_HEALTH
  MANUAL
}

enum PointsReason {
  HEALTH_SYNC
  ACTIVITY_CHECKIN
  CHECKIN_CANCELLED
  ADJUSTMENT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// How a participant entered an event. GROUP = joined via a group admin (their
// groupId is set, they rank in the group-sum board); INDIVIDUAL = joined alone.
enum EventJoinMode {
  GROUP
  INDIVIDUAL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable: Google-only users have no password. Every password-path
  // (login, change-password) must guard for null — see auth.controller.js.
  passwordHash String?
  fullName     String
  nickname     String?
  // Nullable: Google sign-up doesn't collect this; mobile prompts the user
  // to fill it in via edit-profile after first sign-in.
  department   String?
  // Set when the account is linked to (or created via) Google Sign-In.
  googleId     String?  @unique
  role         Role     @default(STAFF)
  avatarUrl    String?
  totalPoints  Int      @default(0)
  syncToken    String   @unique @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  activities    Activity[]
  checkIns      CheckIn[]
  createdGroups AppGroup[]
  groupMembers  GroupMember[]
  healthRecords HealthRecord[]

  // Friend System
  friendsAdded   Friendship[] @relation("UserFriends")
  friendsAddedBy Friendship[] @relation("FriendUsers")

  pointsEntries PointsLedgerEntry[]

  createdEvents      Event[]
  eventParticipation EventParticipant[]

  @@map("users")
}

model Activity {
  id              String         @id @default(uuid())
  title           String
  description     String
  location        String
  startDate       DateTime
  endDate         DateTime
  qrCode          String         @unique
  createdById     String
  status          ActivityStatus @default(UPCOMING)
  maxParticipants Int?
  imageUrl        String?
  points          Int            @default(10)
  expectedSteps   Int?           // Target step count for this activity (optional)
  totalDistance   Float?         // Target distance in km for this activity (optional)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  createdBy User      @relation(fields: [createdById], references: [id])
  checkIns  CheckIn[]

  @@map("activities")
}

model CheckIn {
  id          String        @id @default(uuid())
  userId      String
  activityId  String
  checkedInAt DateTime      @default(now())
  latitude    Float?
  longitude   Float?
  method      CheckInMethod @default(QR)

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@unique([userId, activityId])
  @@map("check_ins")
}

model AppGroup {
  id           String   @id @default(uuid())
  name         String
  description  String?
  qrInviteCode String   @unique
  createdById  String
  // Hierarchy: a group may belong to one parent (e.g. Faculty is parent of
  // Computer/Electrical dept groups). Nullable so existing flat groups are
  // unaffected. Tree is shallow (2 levels) by design — no recursive queries.
  parentGroupId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdBy   User          @relation(fields: [createdById], references: [id])
  members     GroupMember[]
  parentGroup AppGroup?     @relation("GroupTree", fields: [parentGroupId], references: [id])
  childGroups AppGroup[]    @relation("GroupTree")

  eventParticipants EventParticipant[]

  @@map("app_groups")
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  // Relations
  group AppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model HealthRecord {
  id            String       @id @default(uuid())
  userId        String
  recordDate    DateTime     @db.Date
  steps         Int          @default(0)
  calories      Float        @default(0)
  distanceKm    Float        @default(0)
  activeMinutes Int          @default(0)
  source        HealthSource @default(MANUAL)
  createdAt     DateTime     @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, recordDate, source])
  @@map("health_records")
}

// Append-only ledger: the single source of truth for points.
// User.totalPoints is a denormalized cache and must always equal
// SUM(amount) of this table for that user (both are written in the
// same transaction via pointsLedger.service).
model PointsLedgerEntry {
  id            String       @id @default(uuid())
  userId        String
  amount        Int // applied delta; may be negative (cancellation / reduced sync)
  reason        PointsReason
  // Thai calendar day the points belong to (UTC-midnight tag, same convention
  // as HealthRecord.recordDate). Period leaderboards sum over this column.
  effectiveDate DateTime     @db.Date
  // Optional reference: activityId for check-ins, HealthSource for syncs.
  refId         String?
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
  @@map("points_ledger")
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  // Relations
  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

// A step-count competition. Steps are aggregated on read from HealthRecord
// within [startDate, endDate] — an Event owns no points/steps of its own and
// never touches the frozen points/health services.
model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(UPCOMING)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  createdBy    User               @relation(fields: [createdById], references: [id])
  participants EventParticipant[]

  @@map("events")
}

model EventParticipant {
  id       String        @id @default(uuid())
  eventId  String
  userId   String
  // Set only when joinMode = GROUP; the group the participant represents in
  // the group-sum leaderboard. Null for INDIVIDUAL joins.
  groupId  String?
  joinMode EventJoinMode
  joinedAt DateTime      @default(now())

  // Relations
  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id])
  group AppGroup? @relation(fields: [groupId], references: [id])

  // A user participates in a given event at most once.
  @@unique([eventId, userId])
  @@index([eventId, groupId])
  @@map("event_participants")
}
